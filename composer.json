{
    "name": "gammamatrix/playground-login-blade",
    "description": "Playground: Provides an API and a Laravel Blade UI for authentication, authorization, credential updates and user verification.",
    "keywords": [
        "blade",
        "gammamatrix",
        "laravel",
        "login",
        "auth",
        "playground-auth",
        "playground-blade",
        "sanctum"
    ],
    "homepage": "https://gammamatrix-playground.readthedocs.io/en/develop/components/login.html",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeremy Postlethwaite",
            "email": "jeremy.postlethwaite@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "gammamatrix/playground-auth": "*",
        "gammamatrix/playground-blade": "*",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "gammamatrix/playground-test": "*",
        "illuminate/testing": "^13.0",
        "tomasvotruba/bladestan": "dev-main"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Playground\\Login\\Blade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Feature\\Playground\\Login\\Blade\\": "tests/Feature/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "gammamatrix/*": "source",
            "*": "dist"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "75.x-dev"
        },
        "laravel": {
            "providers": [
                "Playground\\Login\\Blade\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --verbose --debug --level max",
        "cloc": "cloc --exclude-dir=output,vendor .",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/testbench package:test",
        "test-dev": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit-dev.xml"
        ],
        "test-parallel": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/paratest -c phpunit-dev.xml"
        ]
    }
}
